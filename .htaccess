<IfModule mod_rewrite.c>
    RewriteEngine On
    # Send all requests to the public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to sensitive files
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "^\.(git|gitignore|gitattributes|editorconfig)">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json|vite\.config\.js|tailwind\.config\.js)">
    Order allow,deny
    Deny from all
</FilesMatch>
